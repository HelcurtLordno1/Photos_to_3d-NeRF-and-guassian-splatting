* text=auto eol=lf

*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.md text eol=lf
*.env text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
*.mp4 binary
*.ply binary

# Research reports include hash-indexed evidence. Preserve their original bytes
# across commits and checkouts instead of normalizing line endings.
reports/** -text
